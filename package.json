{
  "name": "@mutexa/venue-adapters",
  "version": "0.1.0",
  "description": "One read-only interface for perps and lending venues: Hyperliquid and Aave V3 adapters with validated requests, cached reads, venue-reported next to computed liquidation prices, and a conformance kit run against recorded fixtures.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutexa-labs/venue-adapters.git"
  },
  "homepage": "https://github.com/mutexa-labs/venue-adapters#readme",
  "bugs": {
    "url": "https://github.com/mutexa-labs/venue-adapters/issues"
  },
  "keywords": [
    "hyperliquid",
    "aave",
    "perps",
    "lending",
    "liquidation",
    "adapter",
    "cloudflare-workers",
    "mutexa"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aave-v3": {
      "types": "./dist/aave-v3/index.d.ts",
      "import": "./dist/aave-v3/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"{src,test,scripts,examples}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.ts\"",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "record": "tsx scripts/record-hyperliquid.ts",
    "record:aave": "tsx scripts/record-aave.ts"
  },
  "dependencies": {
    "@mutexa/liq-math": "github:mutexa-labs/liq-math#v0.1.0",
    "viem": "^2.57.7"
  },
  "peerDependencies": {
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "hono": "^4.11.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
